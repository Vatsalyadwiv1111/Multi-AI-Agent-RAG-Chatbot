# Required — Hugging Face Inference API token
# Get one free at https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=your_hf_token_here

# Optional — LangSmith tracing. Lets you see every supervisor routing
# decision, tool call, and LLM invocation for each agent in a dashboard.
# Get a free API key at https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=multi-agent-rag-chatbot
